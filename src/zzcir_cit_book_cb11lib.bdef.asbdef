managed implementation in class ZZCIBP_R_CIT_BOOK_CB11LIB unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZZCIR_CIT_BOOK_CB11LIB alias ZzcirCitBookCb11lib
persistent table ZCIT_BOOK_CB11
extensible
draft table ZZCICT_BK_C_DLIB
etag master LastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   BookID;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt;

  field ( readonly : update )
   BookID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZCIT_BOOK_CB11 corresponding extensible
  {
    BookID = BOOK_ID;
    BookName = BOOK_NAME;
    Category = CATEGORY;
    Author = AUTHOR;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
  }

}